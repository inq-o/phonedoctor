<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 설치 앱 전체를 읽어야 광고를 띄운 앱을 짚을 수 있다 (FR-001). 아이콘을 숨긴 앱도 포함 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- 시스템 삭제 확인창 요청 (FR-030). 삭제 자체는 시니어가 시스템 창에서 확인해야 진행된다 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application>
        <receiver
            android:name=".UninstallResultReceiver"
            android:exported="false" />
        <!-- 강력 모드(US8): 공장 초기화한 폰을 QR로 프로비저닝할 때만 기기 소유자가 된다. 출시 빌드에서는 뺀다 (app/src/release) -->
        <receiver
            android:name=".StrongModeAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/core_packages_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".StrongModeProvisioningActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
