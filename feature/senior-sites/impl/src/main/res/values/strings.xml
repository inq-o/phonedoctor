<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="feature_senior_sites_impl_listener_label">사이트 광고 알림 찾기</string>
    <string name="feature_senior_sites_impl_title">사이트 광고 알림</string>
    <string name="feature_senior_sites_impl_home">홈으로</string>
    <string name="feature_senior_sites_impl_allow_access">알림 접근 허용하기</string>
    <string name="feature_senior_sites_impl_access_body">인터넷 사이트가 보내는 광고 알림을 폰주치의가 찾아 드릴 수 있어요. 그러려면 "알림 접근"을 허용해 주세요.</string>
    <string name="feature_senior_sites_impl_access_scope">허용해도 Chrome 사이트 알림만 살펴봐요. 카카오톡·문자 같은 다른 앱 알림은 보지 않고 바로 버려요. 살펴본 내용은 이 폰 밖으로 보내지 않고, 가족에게도 보내지 않아요.</string>
    <string name="feature_senior_sites_impl_manual_title">직접 끄는 법</string>
    <string name="feature_senior_sites_impl_manual_steps">1. 광고 알림을 길게 눌러요.\n2. "알림 끄기"나 톱니바퀴를 눌러요.\n3. 그 사이트의 스위치를 꺼요.\n\n또는 Chrome에서 오른쪽 위 점 세 개 → 설정 → 사이트 설정 → 알림으로 가서, 광고를 보내는 사이트를 "차단"으로 바꿔요.</string>
    <string name="feature_senior_sites_impl_popup_title">Chrome 광고 차단 켜기</string>
    <string name="feature_senior_sites_impl_popup_steps">Chrome에서 오른쪽 위 점 세 개 → 설정 → 사이트 설정으로 가서\n1. "팝업 및 리디렉션"을 차단으로 해 주세요.\n2. "광고"(침입 광고)를 차단으로 해 주세요.\n페이지 안의 광고가 줄어요.</string>
    <string name="feature_senior_sites_impl_empty">아직 광고 알림을 많이 보낸 사이트가 없어요. 찾으면 알려 드릴게요.</string>
    <string name="feature_senior_sites_impl_status_asked">광고 알림을 보내고 있어요. 눌러서 끌 수 있어요</string>
    <string name="feature_senior_sites_impl_status_muted">끄는 화면을 열었어요</string>
    <string name="feature_senior_sites_impl_status_allowed">괜찮은 사이트로 두었어요</string>
    <string name="feature_senior_sites_impl_status_still_on">아직 알림이 와요. 눌러서 다시 꺼 주세요</string>
    <string name="feature_senior_sites_impl_ask_title">%1$s 사이트가 광고 알림을 보내고 있어요</string>
    <string name="feature_senior_sites_impl_still_on_title">%1$s 사이트 알림이 아직 켜져 있어요</string>
    <string name="feature_senior_sites_impl_count_today">오늘 알림을 %1$d번 보냈어요.</string>
    <string name="feature_senior_sites_impl_count_date">%1$d월 %2$d일에 알림을 %3$d번 보냈어요.</string>
    <string name="feature_senior_sites_impl_ask_how">아래 [이 사이트 알림 끄기]를 누르면 이 사이트 알림만 끄는 화면이 열려요. "알림 표시" 스위치를 끄고 돌아와 주세요.</string>
    <string name="feature_senior_sites_impl_ask_allow">뉴스나 은행처럼 받고 싶은 사이트라면 [괜찮은 사이트예요]를 눌러 주세요. 다시 묻지 않아요.</string>
    <string name="feature_senior_sites_impl_turn_off">이 사이트 알림 끄기</string>
    <string name="feature_senior_sites_impl_allow">괜찮은 사이트예요</string>
    <string name="feature_senior_sites_impl_open_again">끄는 화면 다시 열기</string>
    <string name="feature_senior_sites_impl_muted_title">끄는 화면을 열었어요</string>
    <string name="feature_senior_sites_impl_muted_body">"알림 표시" 스위치를 껐다면 이제 %1$s 사이트 알림은 오지 않아요. 그래도 오면 다시 알려 드릴게요.</string>
    <string name="feature_senior_sites_impl_allowed_title">%1$s 사이트는 그대로 둘게요</string>
    <string name="feature_senior_sites_impl_allowed_body">이 사이트 알림은 다시 묻지 않아요.</string>
    <string name="feature_senior_sites_impl_missing">이미 정리된 사이트예요</string>
</resources>
