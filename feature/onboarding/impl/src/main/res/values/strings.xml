<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="feature_onboarding_impl_role_title">어느 폰을 지킬까요?</string>
    <string name="feature_onboarding_impl_role_senior">이 폰을 지켜요</string>
    <string name="feature_onboarding_impl_role_senior_body">이 폰에 깔린 앱을 살펴보고, 광고를 띄우거나 위험한 앱을 찾으면 알려 드려요. 부모님 폰이라면 이쪽이에요.</string>
    <string name="feature_onboarding_impl_role_guardian">가족 폰을 지켜요</string>
    <string name="feature_onboarding_impl_role_guardian_body">부모님 폰에 확인이 필요한 앱이 생기면 이 폰으로 알려 드려요. 부모님 폰에도 폰주치의를 깔고 연결해야 해요.</string>

    <string name="feature_onboarding_impl_step">%1$d단계 중 %2$d단계</string>

    <string name="feature_onboarding_impl_disclosure_title">폰주치의가 하는 일</string>
    <string name="feature_onboarding_impl_disclosure_body_1">폰주치의는 이 폰에 설치된 앱과, 어떤 앱이 화면에 떴는지를 이 폰 안에서 살펴봐요.</string>
    <string name="feature_onboarding_impl_disclosure_body_2">쓰지도 않았는데 광고를 띄우는 앱을 찾으면 알려 드려요.</string>
    <string name="feature_onboarding_impl_disclosure_body_3">살펴본 내용은 이 폰 안에만 두고 폰 밖으로 보내지 않아요. 앱 목록, 사용 기록, 사진, 문자, 위치도 보내지 않아요.</string>
    <string name="feature_onboarding_impl_disclosure_body_3_family">가족과 연결하기 전에는 살펴본 내용을 폰 밖으로 보내지 않아요. 가족과 연결하면 광고를 띄우거나 위험한 앱을 찾았을 때 그 앱의 이름과 이유만 연결한 가족에게 보내요. 다른 앱 목록, 사용 기록, 사진, 문자, 위치는 보내지 않아요.</string>
    <string name="feature_onboarding_impl_disclosure_agree">알겠어요, 시작할게요</string>

    <string name="feature_onboarding_impl_notification_title">알림을 켜 주세요</string>
    <string name="feature_onboarding_impl_notification_body">확인이 필요한 앱을 찾으면 알림으로 알려 드려요.</string>
    <string name="feature_onboarding_impl_notification_allow">알림 켜기</string>
    <string name="feature_onboarding_impl_later">나중에 할게요</string>

    <string name="feature_onboarding_impl_usage_title">사용 기록 보기를 켜 주세요</string>
    <string name="feature_onboarding_impl_usage_body">어떤 앱이 광고를 띄웠는지 찾으려면 필요해요.</string>
    <string name="feature_onboarding_impl_usage_how">다음 화면에서 폰주치의를 찾아 스위치를 켜고, 뒤로 돌아와 주세요.</string>
    <string name="feature_onboarding_impl_usage_open">설정 열기</string>
    <string name="feature_onboarding_impl_usage_granted_title">켜졌어요</string>
    <string name="feature_onboarding_impl_usage_granted_body">이제 광고를 띄우는 앱을 찾을 수 있어요.</string>
    <string name="feature_onboarding_impl_start">시작하기</string>
    <string name="feature_onboarding_impl_next">다음</string>

    <string name="feature_onboarding_impl_family_title">가족과 연결할까요?</string>
    <string name="feature_onboarding_impl_family_body">가족 폰과 연결하면 확인이 필요한 앱이 생겼을 때 가족에게도 알려요. 가족이 지우자고 하면 이 폰에서 알려 드려요.</string>
    <string name="feature_onboarding_impl_family_scope">연결하면 그 앱의 이름과 이유만 가족에게 보내요. 다른 앱 목록·사용 기록·사진·문자·위치는 보내지 않아요.</string>
    <string name="feature_onboarding_impl_family_later">지금 하지 않아도 홈 화면의 [가족] 버튼에서 언제든 할 수 있어요.</string>
    <string name="feature_onboarding_impl_family_connect">가족 연결하기</string>
</resources>
