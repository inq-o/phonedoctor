<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- openapi 전용 키워드(example, components)는 검증과 무관 -->
    <logger name="com.networknt.schema.UnknownKeywordFactory" level="ERROR"/>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
